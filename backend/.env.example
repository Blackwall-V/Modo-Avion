# Django
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — local dev uses individual vars; production uses DATABASE_URL
# (e.g. from Supabase or Neon) which overrides the rest when set.
DB_NAME=modoavion_db
DB_USER=modoavion_user
DB_PASSWORD=modoavion_password
DB_HOST=127.0.0.1
DB_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Firebase Admin SDK — pick ONE of:
#   1. FIREBASE_CREDENTIALS_PATH  → path to a JSON file (local dev).
#   2. FIREBASE_CREDENTIALS_JSON  → raw JSON contents as a string (Render,
#                                   any host where you can't drop a file).
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend
VITE_API_URL=http://localhost:8000/api
