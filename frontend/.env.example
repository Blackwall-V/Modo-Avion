# Backend API base URL. Vite proxies /api to the Django dev server,
# so the default of "/api" works locally with no extra config.
VITE_API_URL=/api

# Firebase web SDK config (get from Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
